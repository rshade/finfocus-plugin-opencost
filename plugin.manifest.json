{
  "name": "opencost",
  "version": "0.1.0",
  "type": "costsource",
  "description": "OpenCost plugin for FinFocus. Reports projected cost, actual cost, pricing, estimates, and batch cost for Kubernetes resources.",
  "capabilities": [
    "PROJECTED_COSTS",
    "ACTUAL_COSTS",
    "PRICING_SPEC",
    "ESTIMATE_COST",
    "BATCH_COST"
  ],
  "executable": "finfocus-plugin-opencost",
  "protocol": "grpc",
  "supported_resources": [
    "kubernetes:core/v1:Namespace",
    "kubernetes:core/v1:Pod",
    "kubernetes:core/v1:Node",
    "kubernetes:apps/v1:Deployment",
    "kubernetes:apps/v1:StatefulSet",
    "kubernetes:apps/v1:DaemonSet",
    "kubernetes:apps/v1:ReplicaSet",
    "kubernetes:batch/v1:Job",
    "kubernetes:batch/v1:CronJob",
    "k8s-namespace",
    "k8s-pod",
    "k8s-controller",
    "k8s-node"
  ],
  "configuration": {
    "baseUrl": {
      "type": "string",
      "description": "Allocation API base URL",
      "required": true,
      "env": "KUBECOST_BASE_URL"
    },
    "apiToken": {
      "type": "string",
      "description": "Ignored in YAML. Read only from the environment.",
      "required": false,
      "env": "KUBECOST_API_TOKEN"
    },
    "defaultWindow": {
      "type": "string",
      "description": "Default time window for queries (e.g., 30d)",
      "required": false,
      "default": "30d",
      "env": "KUBECOST_DEFAULT_WINDOW"
    },
    "timeout": {
      "type": "string",
      "description": "Request timeout duration (e.g., 15s)",
      "required": false,
      "default": "15s",
      "env": "KUBECOST_TIMEOUT"
    },
    "tlsSkipVerify": {
      "type": "boolean",
      "description": "Skip TLS certificate verification",
      "required": false,
      "default": false,
      "env": "KUBECOST_TLS_SKIP_VERIFY"
    }
  }
}