{
  // OpenSpec writes the opsx commands and openspec-* skills. Hand edits are
  // overwritten. The rest of .claude (pick-issue.md, agents) is hand written
  // and stays linted.
  // Release Please writes CHANGELOG.md. Hand edits are overwritten.
  "globs": ["**/*.md"],
  "ignores": [
    ".claude/commands/opsx/**",
    ".claude/skills/openspec-*/**",
    "CHANGELOG.md"
  ]
}
